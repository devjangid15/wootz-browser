  static_files = [ "wootzapp_search.html", "wootzapp_search.css", "wootzapp_search.js" ]

  non_web_component_files = [ "app.ts", "app.html.ts" ]

  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/js:build_ts",
